---
import Base from "../../layouts/Base.astro";
import { ui } from "../../i18n/ui";
import { langs, path, type Lang } from "../../i18n/utils";

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = ui[lang].contact;
---

<Base lang={lang} rest="thanks" title={t.thanksTitle}>
  <section class="container thanks">
    <h1>{t.thanksTitle}</h1>
    <p class="lede">{t.thanksText}</p>
    <p><a class="btn" href={path(lang)}>{t.back}</a></p>
  </section>
</Base>

<style>
  .thanks { padding-block: var(--space-6); display: grid; gap: var(--space-3); }
</style>
