---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../../layouts/Base.astro";
import { ui } from "../../../i18n/ui";
import { path, type Lang } from "../../../i18n/utils";

// Una página por cada archivo de src/content/projects/<idioma>/<slug>.md
export async function getStaticPaths() {
  const all = await getCollection("projects");
  return all.map((entry) => {
    const [lang, slug] = entry.id.split("/");
    return { params: { lang, slug }, props: { entry } };
  });
}

const { lang, slug } = Astro.params as { lang: Lang; slug: string };
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const t = ui[lang];
---

<Base lang={lang} rest={`projects/${slug}`} title={d.title} description={d.summary}>
  <article class="container case">
    <a class="back link" href={`${path(lang)}#projects`}>{t.caseStudy.back}</a>

    <header>
      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>
    </header>

    <dl class="facts">
      <div><dt class="eyebrow">{t.caseStudy.role}</dt><dd>{d.role}</dd></div>
      <div><dt class="eyebrow">{t.caseStudy.year}</dt><dd>{d.year}</dd></div>
      <div><dt class="eyebrow">{t.caseStudy.status}</dt><dd>{t.projects.status[d.status]}</dd></div>
      <div><dt class="eyebrow">{t.caseStudy.stack}</dt><dd>{d.stack.join(" · ")}</dd></div>
      {d.links.length > 0 && (
        <div>
          <dt class="eyebrow">{t.caseStudy.links}</dt>
          <dd>
            {d.links.map((l) => (
              <a class="link" href={l.url} target="_blank" rel="noopener">{l.label} ↗</a>
            ))}
          </dd>
        </div>
      )}
    </dl>

    {d.cover && (
      <figure>
        <Image src={d.cover} alt={d.coverAlt ?? d.title} widths={[480, 800, 1200]} sizes="(min-width: 72rem) 72rem, 100vw" />
      </figure>
    )}

    <div class="prose"><Content /></div>
  </article>
</Base>

<style>
  .case { padding-block: var(--space-5) var(--space-6); display: grid; gap: var(--space-4); }
  .back { font-size: var(--step--1); justify-self: start; }
  header { display: grid; gap: var(--space-3); }
  h1 { font-size: var(--step-4); }

  .facts { display: grid; gap: var(--space-2); margin: 0; border-block: 1px solid var(--line); padding-block: var(--space-3); }
  .facts div { display: grid; gap: 0.2rem; }
  .facts dd { margin: 0; display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; }

  figure { border: 1px solid var(--line); border-radius: 0.75rem; overflow: hidden; }
  figure :global(img) { width: 100%; }

  .prose { max-width: var(--measure); display: grid; gap: var(--space-2); }
  .prose :global(h2) { font-size: var(--step-2); margin-top: var(--space-4); }
  .prose :global(ul) { display: grid; gap: 0.5rem; padding-inline-start: 1.2rem; list-style: disc; }
  .prose :global(li::marker) { color: var(--accent); }
  .prose :global(a) { text-decoration: underline; text-underline-offset: 0.25em; }

  @media (min-width: 48rem) {
    .facts { grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: var(--space-3); }
  }
</style>
