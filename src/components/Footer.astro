---
import { ui, socials } from "../i18n/ui";
import type { Lang } from "../i18n/utils";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
---

<footer>
  <div class="container inner">
    <p class="muted">© {new Date().getFullYear()} Patricio Resio. {t.footer.rights}</p>
    <ul>
      <li><a class="link" href={socials.github} target="_blank" rel="noopener">GitHub</a></li>
      <li><a class="link" href={socials.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
      <li><a class="link" href={`mailto:${socials.email}`}>Email</a></li>
      <li><a class="link" href={socials.whatsapp} target="_blank" rel="noopener">WhatsApp</a></li>
    </ul>
  </div>
</footer>

<style>
  footer { border-top: 1px solid var(--line); padding-block: var(--space-4); font-size: var(--step--1); }
  .inner { display: flex; flex-wrap: wrap; gap: 1rem 2rem; justify-content: space-between; }
  ul { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
</style>
