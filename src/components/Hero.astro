---
import { ui, socials } from "../i18n/ui";
import { path, type Lang } from "../i18n/utils";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].hero;
---

<section class="hero">
  <div class="container">
    <p class="eyebrow">{t.eyebrow}</p>
    <h1>{t.title}</h1>

    <div class="below">
      <div>
        <p class="lede">{t.lede}</p>
        <div class="actions">
          <a class="btn btn--primary" href={socials.cv[lang]} target="_blank" rel="noopener">{t.cv}</a>
          <a class="btn" href={`${path(lang)}#contact`}>{t.contact}</a>
          <a class="btn" href={socials.linkedin} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5C4.98 4.88 3.86 6 2.48 6S0 4.88 0 3.5 1.12 1 2.48 1s2.5 1.12 2.5 2.5zM.5 8h4V24h-4V8zm7.5 0h3.8v2.16h.05c.53-1 1.82-2.16 3.75-2.16 4 0 4.75 2.63 4.75 6.05V24h-4v-7.1c0-1.7-.03-3.88-2.37-3.88-2.37 0-2.73 1.85-2.73 3.76V24h-4V8z"/></svg>
            LinkedIn
          </a>
          <a class="btn" href={socials.github} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12a12 12 0 008.21 11.39c.6.11.82-.26.82-.58v-2.23c-3.34.73-4.04-1.61-4.04-1.61-.55-1.38-1.33-1.75-1.33-1.75-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.08 1.84 2.82 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.66-.3-5.47-1.33-5.47-5.92 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.17 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 016 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.24 2.87.12 3.17.77.84 1.24 1.91 1.24 3.22 0 4.6-2.81 5.62-5.49 5.92.43.37.82 1.1.82 2.22v3.29c0 .32.21.7.83.58A12 12 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
            GitHub
          </a>
        </div>
      </div>

      <dl class="proof">
        {t.proof.map((p) => (
          <div>
            <dt>{p.value}</dt>
            <dd>{p.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .hero { padding-block: clamp(3rem, 2rem + 8vw, 8rem) var(--space-6); }
  h1 { margin-block: var(--space-3) var(--space-5); max-width: 14ch; }
  .below { display: grid; gap: var(--space-5); }
  .actions { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-top: var(--space-4); }
  .actions .btn svg { width: 1.1rem; height: 1.1rem; flex: none; }
  @media (min-width: 40rem) {
    .actions { display: flex; flex-wrap: wrap; }
  }

  .proof { display: grid; gap: var(--space-3); margin: 0; }
  .proof div { border-top: 1px solid var(--line); padding-top: var(--space-2); display: grid; grid-template-columns: 6.5rem 1fr; gap: 1rem; align-items: baseline; }
  dt { white-space: nowrap; font-family: var(--font-display); font-size: var(--step-2); line-height: 1; color: var(--accent); }
  dd { margin: 0; color: var(--muted); font-size: 0.95rem; }

  @media (min-width: 60rem) {
    .below { grid-template-columns: 1.1fr 1fr; align-items: end; gap: var(--space-6); }
  }
</style>
